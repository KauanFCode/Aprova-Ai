# ============================================================================
# AprovaAI - Segurança da Pasta de Uploads
# Impede execução de scripts PHP ou executáveis dentro de /uploads
# ============================================================================

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|pl|py|jsp|asp|aspx|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<IfModule lsapi_module>
    php_flag engine off
</IfModule>
